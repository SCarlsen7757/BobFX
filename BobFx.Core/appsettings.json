{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.StaticAssets.StaticAssetsInvoker": "Error",
      "BobFx.Core.Services": "Information"
    }
  },
  "AllowedHosts": "*",
  "WLed": {
    "Led": {
      "LedCount": 30
    },
    "Discovery": {
      "UpdateIntervalSeconds": 30
    }
  },
  "Countdown": {
    "DurationSeconds": 720,
    "DeviationSeconds": 120
  }
}
