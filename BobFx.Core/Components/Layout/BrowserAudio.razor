@inject SoundService Sounds
@inject IJSRuntime JS
@inject ILogger<BrowserAudio> Logger
@implements IAsyncDisposable
@using BobFx.Core.Services

<div class="audio-controls">
    <button @ref="button" disabled="@(!ready)">@(enabled ? "Mute audio" : "Enable audio")</button>
    <span role="status">@status</span>
</div>

@code {
    private ElementReference button;
    private IJSObjectReference? module;
    private DotNetObjectReference<BrowserAudio>? callback;
    private int sessionId;
    private Task? initialization;
    private bool enabled, ready, disposed;
    private string status = "Audio is muted in this browser.";
    protected override void OnInitialized() => Sounds.SoundRequested += OnSound;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        initialization = InitializeAsync();
        await initialization;
    }
    private async Task InitializeAsync()
    {
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sounds.js");
            if (disposed) return;
            callback = DotNetObjectReference.Create(this);
            sessionId = await module.InvokeAsync<int>("initialize", button, callback);
            if (disposed) return;
            ready = true;
            StateHasChanged();
        }
        catch (JSDisconnectedException ex) { Logger.LogDebug(ex, "Audio circuit closed during initialization"); }
        catch (Exception ex) when (ex is JSException or OperationCanceledException)
        {
            status = "Audio controls could not load. Reload to retry.";
            Logger.LogWarning(ex, "Browser audio initialization failed");
            if (!disposed) StateHasChanged();
        }
    }
    [JSInvokable]
    public Task AudioStatusChanged(bool active, string message) => disposed ? Task.CompletedTask : InvokeAsync(() =>
    {
        if (disposed) return;
        enabled = active;
        status = message;
        StateHasChanged();
    });
    private void OnSound(string path)
    {
        if (!disposed) _ = DeliverAsync(path);
    }
    private async Task DeliverAsync(string path)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (disposed || !enabled || module is null) return;
                try { await module.InvokeVoidAsync("play", sessionId, path); }
                catch (JSException ex) { Logger.LogWarning(ex, "Sound playback failed"); if (!disposed) { status = "Sound playback failed. Enable audio again."; enabled = false; StateHasChanged(); } }
            });
        }
        catch (Exception ex) { Logger.LogDebug(ex, "Audio delivery ended with circuit closure or playback failure"); }
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Sounds.SoundRequested -= OnSound;
        try
        {
            // Initialization may have created a session after disposal began.
            // Wait for its real identifier before removing the browser listener.
            if (initialization is not null) await initialization;
            if (module is not null) await module.InvokeVoidAsync("dispose", sessionId);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or OperationCanceledException) { Logger.LogDebug(ex, "Audio circuit closed"); }
        finally
        {
            try
            {
                if (module is not null) await module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or OperationCanceledException) { Logger.LogDebug(ex, "Audio module disposal ended with circuit closure"); }
            finally { callback?.Dispose(); }
        }
    }
}
