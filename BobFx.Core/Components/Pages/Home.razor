@inject RgbAndSoundControlService Control
@page "/"
@using BobFx.Core.Services
@inject CountdownService CountdownService
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger
@inject TimeProvider Clock
@implements IAsyncDisposable

<PageTitle>Home</PageTitle>



<div class="home-container">
    <h1>BobFx Controller</h1>

    <div class="countdown-section">
        @if (!state.IsRunning && !state.IsPreCountdownRunning)
        {
            @if (showGameOver)
            {
                <div class="game-over-display">
                    <div class="game-over-message">Game Over!</div>
                </div>
            }

            <button class="btn-countdown btn-start" @onclick="StartCountdown" disabled="@(Control.Phase is GamePhase.PreCountdown or GamePhase.Running)">
                <span class="btn-icon">▶</span>
                <span class="btn-text">Start Countdown</span>
            </button>
        }
        else if (state.IsPreCountdownRunning)
        {
            <div class="pre-countdown-display">
                <div class="pre-countdown-label">Pre-Countdown Active</div>
                <div class="pre-countdown-time">@FormatTime(state.PreCountdownRemaining)</div>
                <button class="btn-countdown btn-stop" @onclick="StopCountdown">Stop pre-countdown</button>
            </div>
        }
        else
        {
            @if (showBobMessage)
            {
                <div class="bob-message-display">
                    <div class="bob-message">BOB!</div>
                </div>
            }
            else
            {
                <div class="countdown-running-display">
                    <div class="countdown-running-time">Game on!</div>
                </div>
                <button class="btn-countdown btn-stop" @onclick="StopCountdown">
                    <span class="btn-icon">■</span>
                    <span class="btn-text">Stop Countdown</span>
                </button>
            }
        }
    </div>
</div>

@if (commandError is not null) { <p role="alert" class="error-message">@commandError</p> }

@code {
    private string? commandError;
    private bool showBobMessage, showGameOver, disposed;
    private CountdownSnapshot state = new(false, false, TimeSpan.Zero, TimeSpan.Zero, 0);
    private long? suppressedEndRunId;
    private readonly CancellationTokenSource lifetime = new();
    private Task? refreshTask;
    protected override void OnInitialized()
    {
        ReadState();
        refreshTask = RefreshAsync();
    }
    private void ReadState()
    {
        var latest = CountdownService.Snapshot;
        if (state.RunId != latest.RunId) suppressedEndRunId = null;
        state = latest;
        var now = Clock.GetUtcNow();
        showBobMessage = state.IsRunning && state.StartedUtc is { } start && now < start.AddSeconds(2.5);
        showGameOver = !state.IsRunning && !state.IsPreCountdownRunning && state.RunId != suppressedEndRunId &&
            state.EndedUtc is { } end && now < end.AddSeconds(15);
    }
    private void RenderState()
    {
        ReadState();
        StateHasChanged();
    }
    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(200), Clock);
        try { while (await timer.WaitForNextTickAsync(lifetime.Token)) await InvokeAsync(() => { if (!disposed) RenderState(); }); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { /* Navigating away cancels the display timer. */ }
    }
    private async Task StartCountdown()
    {
        commandError = null;
        try { await Control.StartGameAsync(); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException) { commandError = ex.Message; }
    }
    private async Task StopCountdown()
    {
        try
        {
            if (await JSRuntime.InvokeAsync<bool>("confirm", lifetime.Token, "Stop the countdown?"))
            {
                if (disposed) return;
                var stoppedRunId = CountdownService.Snapshot.RunId;
                await Control.StopGameAsync();
                if (disposed) return;
                ReadState();
                suppressedEndRunId = stoppedRunId;
                RenderState();
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (JSDisconnectedException ex) { Logger.LogDebug(ex, "Game display circuit closed"); }
        catch (Exception ex) when (ex is InvalidOperationException or JSException) { commandError = ex.Message; }
    }
    private static string FormatTime(TimeSpan time) => $"{Math.Max(0, (int)time.TotalSeconds)}";
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await lifetime.CancelAsync();
        if (refreshTask is not null) await refreshTask;
        lifetime.Dispose();
    }
}
