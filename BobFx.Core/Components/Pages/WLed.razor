@page "/wled"
@using BobFx.Core.Services
@using System.Net
@inject WLedDiscoveryService Discovery
@inject IJSRuntime JS
@inject ILogger<WLed> Logger
@inject WLedRegistryService Registry
@inject InstallationSettingsStore Settings
@inject InstallationOutputService Output
@inject RgbAndSoundControlService Control
@implements IAsyncDisposable

<PageTitle>WLED devices</PageTitle>
<h1>WLED devices</h1>
<p>Select the devices BobFX should control, then assign their edge strips on the Board layout page.</p>
<p role="status">@deviceStatus</p>
<fieldset><legend>Add device manually</legend>
    <label for="manual-address">Private IPv4 address</label><input id="manual-address" @bind="manualAddress" />
    <label for="manual-port">HTTP port</label><input id="manual-port" type="number" min="1" max="65535" @bind="manualPort" />
    <button disabled="@deviceBusy" @onclick="AddManual">Check and add device</button>
</fieldset>
@if (Settings.Snapshot.Devices.Count > 0)
{
    <h2>Registered devices</h2>
    @foreach (var saved in Settings.Snapshot.Devices)
    {
        <div>
            <label><input type="checkbox" checked="@saved.Selected" disabled="@deviceBusy" @onchange="e => SelectSaved(saved, (bool)e.Value!)" /> @saved.Name · @Output.Resolve(saved).Address · @Output.Resolve(saved).LedCount LEDs</label>
            <button disabled="@(deviceBusy || Control.Phase != GamePhase.Idle || Control.IsLocating)" @onclick="() => Locate(saved.Mac)">Locate @saved.Name</button>
            <button disabled="@deviceBusy" @onclick="() => RemoveSaved(saved.Mac)">Remove device</button>
            @if (Output.Errors.TryGetValue(saved.Mac, out var error)) { <span role="status">@error</span> }
        </div>
    }
}
<h2>Discovered devices</h2>

<div>
    <button @ref="scanButton" @onclick="Refresh" disabled="@scanning" class="btn btn-primary">@(scanning ? "Scanning…" : "Scan")</button>
    <span role="status">@scanStatus</span>
    <button @onclick="Clear" class="btn btn-secondary">Clear</button>
</div>

<div style="margin-top:10px;">
    @if (Devices == null || Devices.Count == 0)
    {
        <p>No devices found</p>
    }
    else
    {
        <table class="table table-dark">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>IP</th>
                    <th>Host Name</th>
                    <th>MAC</th>
                    <th>Version</th>
                    <th>Port</th>
                    <th>Last Seen</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Devices)
                {
                    <tr>
                        <td>@d.Name</td>
                        <td>@d.Address</td>
                        <td>@d.HostName</td>
                        <td>@FormatMac(d.Mac)</td>
                        <td>@d.Version</td>
                        <td>@d.Port</td>
                        <td>@d.LastSeen.ToLocalTime()</td>
                        <td>@(d.IsOnline ? "Online" : "Offline")</td>
                        <td>
                            @if (d.IsOnline)
                            {
                                <a href="@DeviceUrl(d)" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-light">Web page</a>
                                <button @onclick="() => ShowDetails(d)" class="btn btn-sm btn-outline-info ms-1">Details</button>
                                <button disabled="@deviceBusy" @onclick="() => Register(d)">Select for BobFX</button>
                                <button disabled="@(deviceBusy || Control.Phase != GamePhase.Idle || Control.IsLocating)" @onclick="() => LocateDiscovered(d)">Locate</button>
                            }
                            else
                            {
                                <button @onclick="() => RemoveDevice(d.Address)" class="btn btn-sm btn-outline-danger">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (ShowModal)
{
    <dialog @ref="dialog" class="device-dialog" aria-labelledby="device-title">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-light">
                <div class="modal-header">
                    <h5 id="device-title" class="modal-title">Device Details: @SelectedDevice?.Name</h5>
                    <button aria-label="Close device details" type="button" class="btn-close btn-close-white" @onclick="CloseModal">Close</button>
                </div>
                <div class="modal-body">
                    @if (SelectedDevice?.Info != null)
                    {
                        <p><strong>WiFi Strength:</strong> @SelectedDevice.Info.Wifi?.Rssi dBm</p>
                        <p><strong>LED Count:</strong> @SelectedDevice.Info.Leds?.Count</p>
                        <p><strong>Brand:</strong> @SelectedDevice.Info.Brand</p>
                        <p><strong>Product:</strong> @SelectedDevice.Info.Product</p>
                        <p><strong>Architecture:</strong> @SelectedDevice.Info.Arch</p>
                        <p><strong>Core Version:</strong> @SelectedDevice.Info.Core</p>
                        <p><strong>Free Heap:</strong> @SelectedDevice.Info.Freeheap bytes</p>
                        @if (!string.IsNullOrWhiteSpace(SelectedDevice.Info.Lm))
                        {
                            <p><strong>Data source type:</strong> @SelectedDevice.Info.Lm</p>
                            <p><strong>Data source IP address:</strong> @SelectedDevice.Info.Lip</p>
                        }
                        <p><strong>Uptime:</strong> @TimeSpan.FromSeconds(@SelectedDevice.Info.Uptime).ToString()</p>
                    }
                    else
                    {
                        <p>No additional info available.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
                </div>
            </div>
        </div>
    </dialog>
}

@code {
    private IReadOnlyList<WLedDevice> Devices => Discovery.Devices;
    private bool scanning, disposed, openPending;
    private bool deviceBusy;
    private string manualAddress = "";
    private int manualPort = 80;
    private string? deviceStatus;
    private Task AddManual() => DeviceAction(() => Registry.AddManualAsync(manualAddress, manualPort, lifetime.Token), "Device registered.");
    private Task Register(WLedDevice device) => DeviceAction(() => Registry.SelectAsync(device, lifetime.Token), "Device selected.");
    private Task SelectSaved(DeviceSettings device, bool selected) => DeviceAction(() => Control.ConfigureAsync(() => Settings.UpdateAsync(s => s with
    { Devices = s.Devices.Select(d => d.Mac == device.Mac ? d with { Selected = selected } : d).ToList() }, lifetime.Token)), "Selection saved.");
    private Task Locate(string mac) => DeviceAction(() => Output.LocateAsync(mac, lifetime.Token), "Locate finished.");
    private Task RemoveSaved(string mac) => DeviceAction(() => Control.ConfigureAsync(() => Settings.UpdateAsync(s =>
    {
        if (s.Boards.Any(b => b.DeviceMac == mac) || s.IdleSync.MasterMac == mac || s.IdleSync.Followers.Contains(mac))
            throw new ArgumentException("Remove this device from board layout and idle sync before deleting it.");
        return s with { Devices = s.Devices.Where(d => d.Mac != mac).ToList() };
    }, lifetime.Token)), "Device removed.");
    private Task LocateDiscovered(WLedDevice device) => DeviceAction(async () =>
    {
        await Output.LocateDeviceAsync(new DeviceSettings(device.Mac, device.Name, device.Address.ToString(), device.Port,
            device.Info?.Leds?.Count ?? 0, device.Info?.Udpport ?? 21324, false), lifetime.Token);
    }, "Locate finished.");
    private async Task DeviceAction(Func<Task> action, string success)
    {
        deviceBusy = true;
        try { await action(); if (!disposed) deviceStatus = success; }
        catch (Exception ex) when (ExceptionPolicy.IsRecoverable(ex)) { if (!disposed) deviceStatus = ex.Message; }
        finally { deviceBusy = false; }
    }
    private string? scanStatus;
    private ElementReference dialog, scanButton;
    private IJSObjectReference? module;
    private readonly CancellationTokenSource lifetime = new();
    private Task? scanTask, refreshTask, dialogTask;
    private int refreshRequested;
    private static string DeviceUrl(WLedDevice device) => new UriBuilder("http", device.Address.ToString(), device.Port).Uri.AbsoluteUri;
    private string FormatMac(string mac)
    {
        if (string.IsNullOrEmpty(mac) || mac.Length != 12) return mac;
        return $"{mac[0..2]}:{mac[2..4]}:{mac[4..6]}:{mac[6..8]}:{mac[8..10]}:{mac[10..12]}";
    }

    private WLedDevice? SelectedDevice { get; set; }
    private bool ShowModal { get; set; }

    protected override void OnInitialized()
    {
        Discovery.DevicesUpdated += Discovery_DevicesUpdated;
        refreshTask = RefreshLoopAsync();
    }

    private void Discovery_DevicesUpdated(IReadOnlyList<WLedDevice> devices)
    {
        Interlocked.Exchange(ref refreshRequested, 1);
    }

    private Task Refresh()
    {
        if (disposed || scanning) return Task.CompletedTask;
        scanTask = ScanAsync();
        return scanTask;
    }

    private async Task ScanAsync()
    {
        scanning = true; scanStatus = null;
        try
        {
            await Discovery.ScanAsync(lifetime.Token);
            if (!disposed) scanStatus = "Scan complete.";
        }
        catch (OperationCanceledException ex) when (lifetime.IsCancellationRequested)
        { Logger.LogDebug(ex, "Manual WLED scan cancelled because the page closed"); }
        catch (Exception ex) when (ExceptionPolicy.IsRecoverable(ex))
        {
            Logger.LogWarning(ex, "Manual WLED scan failed");
            if (!disposed) scanStatus = "Scan failed. Check network connectivity and try again.";
        }
        finally { if (!disposed) scanning = false; }
    }

    private void Clear()
    {
        Discovery.Clear();
    }

    private void RemoveDevice(IPAddress address)
    {
        Discovery.Remove(address);
    }

    private void ShowDetails(WLedDevice device)
    {
        SelectedDevice = device;
        ShowModal = true;
        openPending = true;
    }

    private Task CloseModal()
    {
        if (disposed) return Task.CompletedTask;
        return QueueDialogAsync(false);
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(200));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                if (Interlocked.Exchange(ref refreshRequested, 0) != 0)
                    await InvokeAsync(() => { if (!disposed) StateHasChanged(); });
        }
        catch (OperationCanceledException ex) when (lifetime.IsCancellationRequested)
        { Logger.LogDebug(ex, "WLED refresh loop cancelled because the page closed"); }
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (openPending && !disposed)
        {
            openPending = false;
            return QueueDialogAsync(true);
        }
        return Task.CompletedTask;
    }
    private Task QueueDialogAsync(bool open)
    {
        dialogTask = RunDialogAsync(dialogTask, open);
        return dialogTask;
    }
    private async Task RunDialogAsync(Task? previous, bool open)
    {
        if (previous is not null) await previous;
        if (disposed) return;
        try
        {
            // Await import even after navigation so disposal can release a late module.
            if (open) module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
            if (disposed) return;
            if (module is not null)
            {
                if (open) await module.InvokeVoidAsync("open", lifetime.Token, dialog);
                else await module.InvokeVoidAsync("close", lifetime.Token, dialog, scanButton);
            }
            if (!open && !disposed) { ShowModal = false; SelectedDevice = null; }
        }
        catch (OperationCanceledException ex) when (lifetime.IsCancellationRequested)
        { Logger.LogDebug(ex, "WLED dialog operation cancelled because the page closed"); }
        catch (JSDisconnectedException ex) { Logger.LogDebug(ex, "WLED dialog circuit closed"); }
    }
    public async ValueTask DisposeAsync()
    {
        using (lifetime)
        {
            disposed = true;
            Discovery.DevicesUpdated -= Discovery_DevicesUpdated;
            await lifetime.CancelAsync();
            try
            {
                await Task.WhenAll(new[] { scanTask, refreshTask, dialogTask }.OfType<Task>());
            }
            finally
            {
                try
                {
                    if (module is not null) await module.DisposeAsync();
                }
                catch (JSDisconnectedException ex) { Logger.LogDebug(ex, "WLED dialog circuit closed during disposal"); }
            }
        }
    }
}
