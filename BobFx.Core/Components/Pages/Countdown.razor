@page "/countdown"
@using BobFx.Core.Services
@inject CountdownService CountdownService
@inject RgbAndSoundControlService Control
@implements IAsyncDisposable

<PageTitle>Countdown settings</PageTitle>
<h1>Countdown settings</h1>
<p role="status">Remaining: @CountdownService.Remaining.ToString(@"hh\:mm\:ss")</p>
<div class="parameters">
    <label for="minutes">Minutes (0–180)</label><input id="minutes" type="number" @bind="minutes" min="0" max="180" />
    <label for="seconds">Seconds (0–59)</label><input id="seconds" type="number" @bind="seconds" min="0" max="59" />
    <label for="pre">Pre-countdown seconds (1–60)</label><input id="pre" type="number" @bind="pre" min="1" max="60" />
    <label for="deviation">Random deviation seconds (0–300)</label><input id="deviation" type="number" @bind="deviation" min="0" max="300" />
</div>
<div class="button-group">
    <button @onclick="() => StartAsync(false)" disabled="@(Control.Phase is GamePhase.PreCountdown or GamePhase.Running)">Start</button>
    <button @onclick="() => StartAsync(true)" disabled="@(Control.Phase != GamePhase.Idle)">Start with pre-countdown</button>
    <button @onclick="StopAsync" disabled="@(Control.Phase == GamePhase.Idle)">Stop</button>
</div>
@if (error is not null) { <p role="alert" class="error-message">@error</p> }
@code {
    private int minutes = 15, seconds, pre = 5, deviation = 120;
    private string? error;
    private readonly CancellationTokenSource lifetime = new();
    private Task? refresh;
    protected override void OnInitialized() => refresh = RefreshAsync();
    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
        try { while (await timer.WaitForNextTickAsync(lifetime.Token)) await InvokeAsync(StateHasChanged); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { /* Navigating away cancels the settings refresh timer. */ }
    }
    private async Task StartAsync(bool withPre)
    {
        error = null;
        if (minutes is < 0 or > 180 || seconds is < 0 or > 59 || pre is < 1 or > 60 || deviation is < 0 or > 300 || minutes * 60 + seconds <= deviation)
        { error = "Enter valid limits. Total duration must exceed random deviation."; return; }
        try { await Control.StartGameAsync(withPre, TimeSpan.FromSeconds(pre), TimeSpan.FromSeconds(minutes * 60 + seconds), TimeSpan.FromSeconds(deviation)); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException) { error = ex.Message; }
    }
    private async Task StopAsync() { try { await Control.StopGameAsync(); } catch (InvalidOperationException ex) { error = ex.Message; } }
    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync();
        if (refresh is not null)
        {
            await refresh;
        }
        lifetime.Dispose();
    }
}
