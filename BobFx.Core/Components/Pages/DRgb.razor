@inject RgbAndSoundControlService Control
@page "/drgb"
@using BobFx.Core.Services
@using BobFx.Core.Services.Effects
@inject BobFx.Core.Services.DRgbService LedService
@inject IRgbEffectFactory Effects
@implements IAsyncDisposable

<PageTitle>LED effects</PageTitle>
<h1>LED effects</h1>

<p>Current effect: <b>@currentEffect</b></p>
<p>Speed: <b>@LedService.Speed.TotalMilliseconds</b> ms</p>

<label for="effect-type">Effect</label>
<select id="effect-type" @bind="selectedEffect" @bind:after="OnEffectChanged">
    @foreach (var effect in Enum.GetValues<RgbEffect>())
    {
        <option value="@effect">@effect</option>
    }
</select>

<div class="effect-info">
    @if (effectInfo != null)
    {
        <p><em>@effectInfo.Description</em></p>
    }
</div>

<div class="parameters">
    <div>
        <label for="speed">Speed:</label>
                <input id="speed" type="number" @bind="SpeedMs" min="10" max="2000" /> ms
    </div>

    <div>
        <label>LED Count: @LedCount LEDs</label>
    </div>

    @if (effectInfo != null)
    {
        @for (int i = 0; i < effectInfo.TotalColors; i++)
        {
            var colorIndex = i; // Capture for lambda
            var isRequired = i < effectInfo.RequiredColors;
            var colorLabel = i < effectInfo.ColorLabels.Length ? effectInfo.ColorLabels[i] : $"Color {i + 1}";

            <div>
                <label for="@($"color-{colorIndex}")">@colorLabel @(isRequired ? "*" : "(optional)"):</label>
                <input id="@($"color-{colorIndex}")" type="color" @bind="@effectColors[colorIndex]" />
            </div>
        }

        @* Show fade duration parameter for fade effects *@
        @if (selectedEffect == RgbEffect.FadeIn || selectedEffect == RgbEffect.FadeOut)
        {
            <div>
                <label for="fade">Fade Duration:</label>
                <input id="fade" type="number" @bind="FadeDurationSeconds" min="0.1" max="60" step="0.1" /> seconds
            </div>
        }

        @* Show breath duration parameter for breathing effects *@
        @if (selectedEffect == RgbEffect.Breathing)
        {
            <div>
                <label for="breath">Breath Duration:</label>
                <input id="breath" type="number" @bind="BreathDurationSeconds" min="0.1" max="60" step="0.1" /> seconds
            </div>
            <div>
                <label for="minimum">Min Brightness:</label>
                <input id="minimum" type="number" @bind="MinBrightnessProcent" min="0" max="100" step="1" /> %
            </div>
            <div>
                <label for="maximum">Max Brightness:</label>
                <input id="maximum" type="number" @bind="MaxBrightnessProcent" min="10" max="100" step="1" /> %
            </div>
        }
    }
</div>

<div class="button-group">
    <button @onclick="StartEffect" class="btn btn-success">Start</button>
    <button @onclick="StopEffect" class="btn btn-danger">Stop</button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-message" role="alert">
        <strong>Error:</strong> @errorMessage
    </div>
}

<div class="led-preview">
    <h5>LED Preview:</h5>
    <div class="led-strip">
        @foreach (var led in preview)
        {
            <div class="led-pixel" style="background:@ToCssColor(led);"></div>
        }
    </div>
</div>

@code {
    private RgbEffect selectedEffect = RgbEffect.Rainbow;
    private RgbEffect currentEffect = RgbEffect.Off;
    private RgbEffectInfo? effectInfo;
    private readonly List<string> effectColors = new(); // Support up to 5 colors
    private string? errorMessage;

    private int speedMs = 100;
    public int SpeedMs
    {
        get => speedMs;
        set
        {
            if (speedMs == value) return;
            speedMs = value;

        }
    }

    private int ledCount => LedService.LedCount;
    public int LedCount
    {
        get => ledCount;
    }

    private double fadeDurationSeconds = 2.0d;
    public double FadeDurationSeconds
    {
        get => fadeDurationSeconds;
        set
        {
            fadeDurationSeconds = value;
        }
    }

    private double breathDurationSeconds = 2.0d;
    public double BreathDurationSeconds
    {
        get => breathDurationSeconds;
        set
        {
            breathDurationSeconds = value;
        }
    }

    private double minBrightnessProcent = 0.0d;
    public double MinBrightnessProcent
    {
        get => minBrightnessProcent;
        set
        {
            minBrightnessProcent = value;
        }
    }

    private double maxBrightnessProcent = 100.0d;
    public double MaxBrightnessProcent
    {
        get => maxBrightnessProcent;
        set
        {
            maxBrightnessProcent = value;
        }
    }

    protected override void OnInitialized()
    {
        // Initialize default colors to a valid color (will be overwritten by LoadDefaultColors)
        for (int i = 0; i < 5; i++)
        {
            effectColors.Add("#FF0000"); // Default to red
        }

        refreshTask = RefreshAsync();
        OnEffectChanged();
    }

    private void OnEffectChanged()
    {
        if (Effects.IsRegistered(selectedEffect))
        {
            var info = Effects.Create(selectedEffect).GetInfo();
            effectInfo = info;
            speedMs = (int)info.DefaultSpeed.TotalMilliseconds;

            // Load default colors based on effect type
            LoadDefaultColors();

            // Load default fade duration for fade effects
            if (selectedEffect == RgbEffect.FadeIn || selectedEffect == RgbEffect.FadeOut)
            {
                fadeDurationSeconds = 2.0;
            }

            // Load default breath duration for breathing effects
            if (selectedEffect == RgbEffect.Breathing)
            {
                breathDurationSeconds = 2.0;
                minBrightnessProcent = 0.0;
                maxBrightnessProcent = 100.0;
            }
        }
        StateHasChanged();
    }

    private void LoadDefaultColors()
    {
        effectColors.Clear();
        // Set sensible defaults for each effect type
        switch (selectedEffect)
        {
            case RgbEffect.Strobe:
            case RgbEffect.Solid:
            case RgbEffect.Scanner:
            case RgbEffect.FadeIn:
            case RgbEffect.FadeOut:
            case RgbEffect.Breathing:
            case RgbEffect.Twinkle:
                effectColors.Add("#FF0000"); // Red for single-color effects
                break;
            case RgbEffect.Blink:
                effectColors.Add("#FF0000"); // Red
                effectColors.Add("#0000FF"); // Blue
                break;
            case RgbEffect.Rainbow:
            case RgbEffect.Off:
                // These effects don't use colors
                break;
        }
    }

    private readonly CancellationTokenSource lifetime = new();
    private System.Numerics.Vector3[] preview = [];
    private Task? refreshTask;
    private bool disposed;
    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(70));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(() => { if (disposed) return; preview = LedService.GetSnapshot(); currentEffect = LedService.CurrentEffect; StateHasChanged(); });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    private async Task StartEffect()
    {
        errorMessage = null;
        try
        {
            if (effectInfo is null) throw new InvalidOperationException("Select a supported effect.");
            if (SpeedMs is < 10 or > 2000) throw new InvalidOperationException("Speed must be 10–2000 ms.");
            if (!double.IsFinite(fadeDurationSeconds) || fadeDurationSeconds is < 0.1 or > 60 || !double.IsFinite(breathDurationSeconds) || breathDurationSeconds is < 0.1 or > 60)
                throw new InvalidOperationException("Effect duration must be 0.1–60 seconds.");
            if (!double.IsFinite(minBrightnessProcent) || !double.IsFinite(maxBrightnessProcent) || minBrightnessProcent < 0 || maxBrightnessProcent > 100 || minBrightnessProcent > maxBrightnessProcent)
                throw new InvalidOperationException("Brightness must be 0–100%, with minimum no greater than maximum.");
            var colors = effectColors.Select(ColorHelper.HexToRgb).ToArray();
            if (colors.Take(effectInfo.RequiredColors).Any(c => c == System.Numerics.Vector3.Zero))
                throw new InvalidOperationException("Required colors must be non-black.");
            await Control.StartManualEffectAsync(builder =>
            {
                builder.WithEffect(selectedEffect).WithSpeed(TimeSpan.FromMilliseconds(SpeedMs));
                foreach (var color in colors) builder.WithColor(color);
                if (selectedEffect is RgbEffect.FadeIn or RgbEffect.FadeOut) builder.WithFadeDuration(fadeDurationSeconds);
                if (selectedEffect == RgbEffect.Breathing) builder.WithBreathDuration(breathDurationSeconds).WithMinBrightness(minBrightnessProcent / 100).WithMaxBrightness(maxBrightnessProcent / 100);
            });
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or FormatException) { errorMessage = ex.Message; }
    }

    private async Task StopEffect()
    {
        try { await Control.StopManualEffectAsync(); } catch (InvalidOperationException ex) { errorMessage = ex.Message; }
    }

    private string ToCssColor(System.Numerics.Vector3 rgb)
    {
        var (r, g, b) = ColorHelper.ToRgbBytes(rgb);
        return $"rgb({r},{g},{b})";
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await lifetime.CancelAsync();
        if (refreshTask is not null) await refreshTask;
        lifetime.Dispose();
    }
}
