# Copy to .env; supply a real release digest from GHCR.
BOBFX_IMAGE_REPOSITORY=ghcr.io/scarlsen7757/bobfx
BOBFX_IMAGE_DIGEST=sha256:REPLACE_WITH_PUBLISHED_DIGEST
BOBFX_BIND_ADDRESS=192.168.100.10
BOBFX_ALLOWED_HOSTS=192.168.100.10;bobfx.local
# Include the host bind address in this trusted subnet for container health probes.
BOBFX_ALLOWED_CLIENT_CIDR=192.168.100.0/24
WLED_TARGET_ADDRESS=192.168.100.255
WLED_LED_COUNT=40
